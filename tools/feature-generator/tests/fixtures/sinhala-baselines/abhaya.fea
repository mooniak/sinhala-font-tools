sub ma-taml	iisign-taml	by	mIi-taml	;
sub ya-taml	iisign-taml	by	yIi-taml	;
sub ra-taml	iisign-taml	by	rIi-taml	;
sub la-taml	iisign-taml	by	lIi-taml	;
