#----------- Sinhala touching  ------------
#---------------------------------


feature akhn {
	lookup sin_touch {
  		sub zerowidthjoiner virama-sinh' by touch-sinh;
	} sin_touch;
} akhn;


#----------- Sinhala touching reph combinations  ------------
# Push the Reph the middle when touching two consonants with Reph


@REPH_REPLACEMENT_1 = [ ka_repha-sinh ga_repha-sinh nna_repha-sinh ta_repha-sinh bha_repha-sinh ya_repha-sinh da_repha-sinh ];
@REPH_REPLACEMENT_2 = [ kha_repha-sinh gha_repha-sinh ca_repha-sinh  tta_repha-sinh dda_repha-sinh dha_repha-sinh ma_repha-sinh va_repha-sinh pa_repha-sinh sa_repha-sinh ba_repha-sinh la_repha-sinh da_repha-sinh jha_repha-sinh ];


lookup touch_reph_decompose {
	sub ka_repha-sinh by ka-sinh  repha-sinh.001;
	sub jha_repha-sinh by jha-sinh repha-sinh.001;
	sub gha_repha-sinh by gha-sinh repha-sinh.001;
	sub ta_repha-sinh by ta-sinh repha-sinh.001;
	sub bha_repha-sinh by bha-sinh repha-sinh.001;
	sub ga_repha-sinh by ga-sinh repha-sinh.002;
	sub kha_repha-sinh by kha-sinh repha-sinh.002;
	sub ca_repha-sinh by ca-sinh repha-sinh.002;
	sub tta_repha-sinh by tta-sinh repha-sinh.002;
	sub dda_repha-sinh by dda-sinh repha-sinh.002;
	sub ma_repha-sinh by ma-sinh repha-sinh.002;
	sub va_repha-sinh by va-sinh repha-sinh.002;
	sub dha_repha-sinh by dha-sinh repha-sinh.002;
	sub ba_repha-sinh by ba-sinh repha-sinh.002;
	sub pa_repha-sinh by pa-sinh repha-sinh.005;
	sub la_repha-sinh by la-sinh repha-sinh.005;
	sub ya_repha-sinh by ya-sinh repha-sinh.005;
	sub da_repha-sinh by da-sinh repha-sinh.009;
	sub nna_repha-sinh by nna-sinh repha-sinh.010;
}touch_reph_decompose;
 
lookup touch_reph{
	sub touch-sinh @REPH_REPLACEMENT_1' lookup touch_reph_decompose;
	sub touch-sinh @REPH_REPLACEMENT_2' lookup touch_reph_decompose;
}touch_reph;


#----------- Sinhala touching reph with MatraI /Ii  ------------
# Push the Reph to on top of the first consonant in a touching ligature when the second consonat is combined with -i and -ii

@BASE_ASCENDING = [ kha-sinh nga-sinh nnga-sinh ca-sinh jha-sinh tta-sinh ttha-sinh dda-sinh ddha-sinh nndda-sinh tha-sinh dha-sinh pha-sinh ba-sinh ma-sinh mba-sinh va-sinh];
@BASE_BODY_HEIGHT = [ ka-sinh ga-sinh gha-sinh cha-sinh ja-sinh nya-sinh jnya-sinh nyja-sinh nna-sinh ta-sinh na-sinh pa-sinh bha-sinh ya-sinh la-sinh sha-sinh ssa-sinh sa-sinh ha-sinh lla-sinh fa-sinh];
@BASE_NARROW = [da-sinh nda-sinh];


@REPH_REPLACEMENT_MATRAI_1 = [ kI-sinh khI-sinh gI-sinh ghI-sinh ngI-sinh nngI-sinh cI-sinh chI-sinh jI-sinh jhI-sinh nyI-sinh jnyI-sinh nyjI-sinh ttI-sinh tthI-sinh ddI-sinh ddhI-sinh nnI-sinh nnddI-sinh tI-sinh thI-sinh dI-sinh dhI-sinh nI-sinh ndI-sinh pI-sinh phI-sinh bI-sinh bhI-sinh mI-sinh mbI-sinh yI-sinh rI-sinh lI-sinh vI-sinh shI-sinh ssI-sinh sI-sinh hI-sinh llI-sinh fI-sinh fpI-sinh kSsI-sinh kVI-sinh tVI-sinh tThI-sinh nDI-sinh nDhI-sinh nVI-sinh nThI-sinh gDhI-sinh dVI-sinh dDhI-sinh ttTthI-sinh nyCI-sinh nyChI-sinh cCI-sinh bBI-sinh];

@REPH_REPLACEMENT_MATRAIi_1 = [ kIi-sinh khIi-sinh gIi-sinh ghIi-sinh ngIi-sinh nngIi-sinh cIi-sinh chIi-sinh jIi-sinh jhIi-sinh nyIi-sinh jnyIi-sinh nyjIi-sinh ttIi-sinh tthIi-sinh ddIi-sinh ddhIi-sinh nnIi-sinh nnddIi-sinh tIi-sinh thIi-sinh dIi-sinh dhIi-sinh nIi-sinh ndIi-sinh pIi-sinh phIi-sinh bIi-sinh bhIi-sinh mIi-sinh mbIi-sinh yIi-sinh rIi-sinh lIi-sinh vIi-sinh shIi-sinh ssIi-sinh sIi-sinh hIi-sinh llIi-sinh fIi-sinh fpIi-sinh kSsIi-sinh kVIi-sinh tVIi-sinh tThIi-sinh nDIi-sinh nDhIi-sinh nVIi-sinh nThIi-sinh gDhIi-sinh dVIi-sinh dDhIi-sinh ttTthIi-sinh nyCIi-sinh nyChIi-sinh cCIi-sinh bBIi-sinh];


lookup touch_reph_matraI {
	sub @BASE_ASCENDING touch-sinh @REPH_REPLACEMENT_MATRAI_1 repha-sinh' by repha-sinh.003;
	sub @BASE_ASCENDING touch-sinh @REPH_REPLACEMENT_MATRAIi_1 repha-sinh' by repha-sinh.003;
	sub @BASE_NARROW touch-sinh @REPH_REPLACEMENT_MATRAI_1 repha-sinh' by repha-sinh.005;
	sub @BASE_NARROW touch-sinh @REPH_REPLACEMENT_MATRAIi_1 repha-sinh' by repha-sinh.005;

	sub @BASE_BODY_HEIGHT touch-sinh @REPH_REPLACEMENT_MATRAI_1 repha-sinh' by repha-sinh.004;
	sub @BASE_BODY_HEIGHT touch-sinh @REPH_REPLACEMENT_MATRAIi_1 repha-sinh' by repha-sinh.004;
	sub @BASE_NARROW touch-sinh @REPH_REPLACEMENT_MATRAI_1 repha-sinh' by repha-sinh.005;
}touch_reph_matraI;

#----------- Sinhala MatraI and MatraII Reph combinations  ------------
# Place the Reph inside the MatraI and MatraII


@MATRAI_1 = [ kI-sinh khI-sinh gI-sinh ghI-sinh ngI-sinh nngI-sinh cI-sinh chI-sinh jI-sinh jhI-sinh nyI-sinh jnyI-sinh nyjI-sinh ttI-sinh ddI-sinh nnddI-sinh tI-sinh dI-sinh dhI-sinh nI-sinh ndI-sinh pI-sinh bI-sinh bhI-sinh mI-sinh mbI-sinh yI-sinh rI-sinh lI-sinh vI-sinh shI-sinh ssI-sinh sI-sinh hI-sinh llI-sinh fI-sinh fpI-sinh kSsI-sinh kVI-sinh tVI-sinh nDI-sinh nDhI-sinh nVI-sinh gDhI-sinh dVI-sinh dDhI-sinh ttTthI-sinh nyCI-sinh nyChI-sinh cCI-sinh bBI-sinh kIi-sinh khIi-sinh gIi-sinh ghIi-sinh ngIi-sinh nngIi-sinh cIi-sinh chIi-sinh jIi-sinh jhIi-sinh nyIi-sinh jnyIi-sinh nyjIi-sinh ttIi-sinh ddIi-sinh nnIi-sinh nnddIi-sinh tIi-sinh dIi-sinh dhIi-sinh nIi-sinh ndIi-sinh pIi-sinh bIi-sinh bhIi-sinh mIi-sinh mbIi-sinh yIi-sinh rIi-sinh lIi-sinh vIi-sinh shIi-sinh ssIi-sinh sIi-sinh hIi-sinh llIi-sinh fIi-sinh fpIi-sinh kSsIi-sinh kVIi-sinh tVIi-sinh nDIi-sinh nDhIi-sinh nVIi-sinh gDhIi-sinh dVIi-sinh dDhIi-sinh nyCIi-sinh nyChIi-sinh cCIi-sinh bBIi-sinh ];

@MATRAI_2 = [ tthI-sinh ddhI-sinh  thI-sinh phI-sinh tThI-sinh nThI-sinh tthIi-sinh ddhIi-sinh thIi-sinh phIi-sinh tThIi-sinh nThIi-sinh  ];

@MATRAI_3 = [nnI-sinh nnIi-sinh];

lookup matraI_matraII_reph {
	sub @MATRAI_1 repha-sinh' by repha-sinh.006;
	sub @MATRAI_2 repha-sinh' by repha-sinh.007;
	sub @MATRAI_3 repha-sinh' by repha-sinh.008;
}matraI_matraII_reph;


#----------- Sinhala Candrabindu placement  ------------
# Place the Reph inside the MatraI and MatraII


lookup candrabindu-sinh {
	sub @BASE_BODY_HEIGHT candrabindu-sinh' by candrabindu-sinh.001;
} candrabindu-sinh;






# Prefix: Prefix
@TA_MATRA_U_1 = [ nga-taml pa-taml ya-taml va-taml ];

#---- AKHN ----

lookup akhands {
    sub ka-taml virama-taml ssa-taml by kSsa-taml;
    sub sha-taml virama-taml ra-taml iisign-taml by shree-taml;
    sub sa-taml virama-taml ra-taml iisign-taml by shree-taml;
    
} akhands;



#---- ABVS ----

lookup above_base_sub_1 {
sub ka-taml	isign-taml	by	kI-taml	;
sub nga-taml	isign-taml	by	ngI-taml	;
sub ca-taml	isign-taml	by	cI-taml	;
sub nya-taml	isign-taml	by	nyI-taml	;
sub tta-taml	isign-taml	by	ttI-taml	;
sub nna-taml	isign-taml	by	nnI-taml	;
sub ta-taml	isign-taml	by	tI-taml	;
sub na-taml	isign-taml	by	nI-taml	;
sub pa-taml	isign-taml	by	pI-taml	;
sub ma-taml	isign-taml	by	mI-taml	;
sub ya-taml	isign-taml	by	yI-taml	;
sub ra-taml	isign-taml	by	rI-taml	;
sub la-taml	isign-taml	by	lI-taml	;
sub va-taml	isign-taml	by	vI-taml	;
sub zha-taml	isign-taml	by	zhI-taml	;
sub lla-taml	isign-taml	by	llI-taml	;
sub rra-taml	isign-taml	by	rrI-taml	;
sub nna2-taml	isign-taml	by	nna2-i-taml	;
sub ja-taml	isign-taml	by	jI-taml	;
sub ssa-taml	isign-taml	by	ssI-taml	;
sub sa-taml	isign-taml	by	sI-taml	;
sub ha-taml	isign-taml	by	hI-taml	;
sub kSsa-taml	isign-taml	by	kSsI-taml	;
sub sha-taml	isign-taml	by	shI-taml	;
} above_base_sub_1;

lookup above_base_sub_2 {
sub ka-taml	iisign-taml	by	kIi-taml	;
sub nga-taml	iisign-taml	by	ngIi-taml	;
sub ca-taml	iisign-taml	by	cIi-taml	;
sub nya-taml	iisign-taml	by	nyIi-taml	;
sub tta-taml	iisign-taml	by	ttIi-taml	;
