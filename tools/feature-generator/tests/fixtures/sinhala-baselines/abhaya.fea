 } above_base_sub_2;

#---- PSTS ----

lookup post_base_sub_1 {
    sub ka-taml usign-taml by kU-taml;
    sub ca-taml usign-taml by cU-taml;
    sub nya-taml usign-taml by nyU-taml;
    sub tta-taml usign-taml by ttU-taml;
    sub nna-taml usign-taml by nnU-taml;
    sub ta-taml usign-taml by tU-taml;
    sub na-taml usign-taml by nU-taml;
    sub nna2-taml usign-taml by nna2-u-taml;
    sub pa-taml usign-taml by pU-taml;
	sub ma-taml usign-taml by mU-taml;
    sub ra-taml usign-taml by rU-taml;
    sub rra-taml usign-taml by rrU-taml;
    sub la-taml usign-taml by lU-taml;
    sub lla-taml usign-taml by llU-taml;
    sub zha-taml usign-taml by zhU-taml;
    sub ja-taml usign-taml by jU-taml;
    sub sa-taml usign-taml by sU-taml;
    sub ssa-taml usign-taml by ssU-taml;
    sub kSsa-taml usign-taml by kSsU-taml;
    sub ha-taml usign-taml by hU-taml;



} post_base_sub_1;

lookup post_base_sub_2 {
    sub ka-taml uusign-taml by kUu-taml;
    sub nga-taml uusign-taml by ngUu-taml;
    sub ca-taml uusign-taml by cUu-taml;
    sub nya-taml uusign-taml by nyUu-taml;
    sub tta-taml uusign-taml by ttUu-taml;
    sub nna-taml uusign-taml by nnUu-taml;
    sub ta-taml uusign-taml by tUu-taml;
    sub na-taml uusign-taml by nUu-taml;
    sub nna2-taml uusign-taml by nna2-uu-taml;
    sub pa-taml uusign-taml by pUu-taml;
    sub ya-taml uusign-taml by yUu-taml;
    sub ma-taml uusign-taml by mUu-taml;
    sub ra-taml uusign-taml by rUu-taml;
    sub rra-taml uusign-taml by rrUu-taml;
    sub la-taml uusign-taml by lUu-taml;
    sub lla-taml uusign-taml by llUu-taml;
    sub zha-taml uusign-taml by zhUu-taml;
    sub va-taml uusign-taml by vUu-taml;
    sub ja-taml uusign-taml by jUu-taml;
    sub ssa-taml uusign-taml by ssUu-taml;
    sub kSsa-taml uusign-taml by kSsUu-taml;
    sub ha-taml uusign-taml by hUu-taml;

 } post_base_sub_2;


lookup post_base_sub_3{
    sub @TA_MATRA_U_1 usign-taml' by usign.alt1-taml;
 } post_base_sub_3;










feature ccmp {
# i and j lose their dot when a top mark follows (soft-dotted letters)
lookup ccmp_latn_dotless {
  sub i' [gravecomb acutecomb circumflexcomb tildecomb macroncomb brevecomb dotaccentcomb dieresiscomb ringcomb hungarumlautcomb caroncomb] by dotlessi;
  sub j' [gravecomb acutecomb circumflexcomb tildecomb macroncomb brevecomb dotaccentcomb dieresiscomb ringcomb hungarumlautcomb caroncomb] by dotlessj;
} ccmp_latn_dotless;
} ccmp;

feature aalt {
# automatic
feature sups;
feature numr;
feature frac;
feature ordn;
feature onum;
feature lnum;
feature abvs;
feature psts;
feature ss01;

} aalt;

feature sups {
# automatic
sub one by onesuperior;
sub two by twosuperior;
sub three by threesuperior;

} sups;

feature numr {
# automatic
sub zero by zero.numr;
sub one by one.numr;
sub two by two.numr;
sub three by three.numr;
sub four by four.numr;
sub five by five.numr;
sub six by six.numr;
sub seven by seven.numr;
sub eight by eight.numr;
sub nine by nine.numr;

} numr;

feature frac {
# automatic
sub one slash four by onequarter;
sub one slash two by onehalf;
sub three slash four by threequarters;

} frac;

feature ordn {
# automatic
sub [zero one two three four five six seven eight nine] [A a]' by ordfeminine;
sub [zero one two three four five six seven eight nine] [O o]' by ordmasculine;

} ordn;

feature onum {
# automatic
sub zero by zero.osf;
sub one by one.osf;
sub two by two.osf;
sub three by three.osf;
sub four by four.osf;
sub five by five.osf;
sub six by six.osf;
sub seven by seven.osf;
sub eight by eight.osf;
sub nine by nine.osf;

} onum;

feature lnum {
sub zero.osf by zero;
sub one.osf by one;
sub two.osf by two;
sub three.osf by three;
sub four.osf by four;
sub five.osf by five;
sub six.osf by six;
sub seven.osf by seven;
sub eight.osf by eight;
sub nine.osf by nine;

} lnum;

feature liga {
# automatic
lookupflag IgnoreMarks;
sub f f i by f_f_i;
sub f f l by f_f_l;
sub f f by f_f;
sub f i by fi;
sub f l by fl;

} liga;

feature akhn {
    script taml;
        lookup akhands;
    script tml2;
        lookup akhands;
} akhn;

