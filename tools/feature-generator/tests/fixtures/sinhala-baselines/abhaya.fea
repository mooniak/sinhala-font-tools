# Prefix: Languagesystems
languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem sinh dflt;
languagesystem taml dflt;
languagesystem tml2 dflt;


# Prefix: Prefix

#----------- Yansaya and Rakar --------------
#-------------------------------

lookup sin_vatu {
  sub virama-sinh zerowidthjoiner ya-sinh by yasign-sinh;
  sub virama-sinh zerowidthjoiner ra-sinh by rasign-sinh;
} sin_vatu;


