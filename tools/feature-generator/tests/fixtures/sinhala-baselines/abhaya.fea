sub rra-taml	iisign-taml	by	rrIi-taml	;
sub nna2-taml	iisign-taml	by	nna2-ii-taml	;
sub ja-taml	iisign-taml	by	jIi-taml	;
sub ssa-taml	iisign-taml	by	ssIi-taml	;
sub sa-taml	iisign-taml	by	sIi-taml	;
sub ha-taml	iisign-taml	by	hIi-taml	;
sub kSsa-taml	iisign-taml	by	kSsIi-taml	;
