feature ss09 {
featureNames {
  name "Tamil old orthography ligatures";
};
sub nna-taml aasign-taml by nnAa-taml;
sub nna2-taml aasign-taml by nna2-aa-taml;
sub rra-taml aasign-taml by rrAa-taml;

sub aisign-taml nna-taml by nnAi-taml;
sub aisign-taml nna2-taml by nna2-ai-taml;
sub aisign-taml la-taml by lAi-taml;
sub aisign-taml lla-taml by llAi-taml;
} ss09;
