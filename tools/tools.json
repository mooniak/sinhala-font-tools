{
  "groups": [
    { "id": "model", "title": "Design models" },
    { "id": "analyse", "title": "Test & analyse" },
    { "id": "generate", "title": "Generate" },
    { "id": "build", "title": "Build & Glyphs (command line)" }
  ],
  "tools": [
    { "id": "design-stages", "group": "model", "type": "web", "title": "Design stages",
      "desc": "Dependency-based development model: what to draw, in what order.",
      "path": "sinhala-design-stages/index.html", "readme": "sinhala-design-stages/README.md" },
    { "id": "glyph-chart", "group": "analyse", "type": "web", "title": "Glyph chart",
      "desc": "Font tester: base letters × vowel marks and compound signs.",
      "path": "tools/glyph-chart/index.html", "readme": "tools/glyph-chart/README.md" },
    { "id": "spacing-workbench", "group": "analyse", "type": "web", "title": "Spacing workbench",
      "desc": "Inspect and tune the spacing scheme against a font.",
      "path": "tools/spacing-workbench/index.html", "readme": "tools/spacing-workbench/README.md" },
    { "id": "font-comparison", "group": "analyse", "type": "web", "title": "Font comparison",
      "desc": "Side-by-side rendering comparison across fonts.",
      "path": "tools/font-comparison/index.html", "readme": "tools/font-comparison/README.md" },
    { "id": "test-generator", "group": "generate", "type": "web", "title": "Test generator",
      "desc": "Real words and running text using only the graphemes a font has.",
      "path": "tools/test-generator/index.html", "readme": "tools/test-generator/README.md" },
    { "id": "glyphname-converter", "group": "generate", "type": "web", "title": "Glyph name ↔ Unicode",
      "desc": "Convert Sinhala clusters to LankaGlyphset names and back.",
      "path": "tools/glyphname-unicode-converter/index.html", "readme": "tools/glyphname-unicode-converter/README.md" },
    { "id": "spacing-map", "group": "build", "type": "cli", "title": "spacing-map",
      "desc": "Builds sinhala-spacing.yaml from the stages model and audits a font's sidebearings.",
      "readme": "tools/spacing-map/README.md",
      "commands": ["cd tools/spacing-map", "python3 -m venv venv && ./venv/bin/pip install -r requirements.txt", "./venv/bin/python -m spacing_map --help"] },
    { "id": "composite-map", "group": "build", "type": "cli", "title": "composite-map",
      "desc": "Builds the composite map and rebuilds atomic glyphs as composites in Glyphs sources.",
      "readme": "tools/composite-map/README.md",
      "commands": ["cd tools/composite-map", "python3 -m venv venv && ./venv/bin/pip install -r requirements.txt", "./venv/bin/python -m composite_map build-map"] },
    { "id": "feature-generator", "group": "build", "type": "cli", "title": "lankafea",
      "desc": "Generates Sinhala/Tamil OpenType features from lanka-glyphsets; also a Glyphs 3 plugin.",
      "readme": "tools/feature-generator/README.md",
      "commands": ["cd tools/feature-generator", "python3 -m venv .venv && .venv/bin/pip install -e .", "lankafea generate --script sinhala --font MyFont.ttf -o features.fea"] },
    { "id": "glyphs-filters", "group": "build", "type": "cli", "title": "Glyphs filters",
      "desc": "Generates Glyphs 3 sidebar filters from the models into filters/.",
      "readme": "tools/glyphs-filters/README.md",
      "commands": ["node tools/glyphs-filters/build.js", "node tools/glyphs-filters/build.js --check"] },
    { "id": "corpus-build", "group": "build", "type": "cli", "title": "Corpus build",
      "desc": "Builds the test-generator data bundle from the raw UCSC corpora (not in the repo).",
      "readme": "test-texts/corpus-build/README.md",
      "commands": ["node test-texts/corpus-build/build.js"] }
  ]
}
